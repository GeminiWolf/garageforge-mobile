{
  "name": "garageforge",
  "version": "2.1.0",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "node scripts/run-ios.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"{src,__tests__,scripts}/**/*.{js,ts,tsx}\" \"*.{js,ts,tsx}\"",
    "format:check": "prettier --check \"{src,__tests__,scripts}/**/*.{js,ts,tsx}\" \"*.{js,ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "start": "react-native start",
    "test": "jest",
    "version:patch": "node scripts/bump-version.js patch",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "version:set": "node scripts/bump-version.js set",
    "version:build": "node scripts/bump-version.js build",
    "version:sync": "node scripts/bump-version.js sync",
    "build:android": "cd android && ./gradlew assembleRelease",
    "build:android:apk": "cd android && ./gradlew assembleRelease",
    "build:android:aab": "cd android && ./gradlew bundleRelease",
    "build:ios": "xcodebuild -workspace ios/garageforge.xcworkspace -scheme garageforge -configuration Release -sdk iphoneos -archivePath build/GarageForge.xcarchive archive",
    "clean:android": "cd android && ./gradlew clean",
    "test:ios": "xcodebuild -workspace ios/garageforge.xcworkspace -scheme GarageForgeUITests -derivedDataPath ios/build -parallel-testing-enabled NO test"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/datetimepicker": "9.2.2",
    "@react-native/new-app-screen": "0.86.0",
    "@react-navigation/bottom-tabs": "^7.18.11",
    "@react-navigation/elements": "^2.9.33",
    "@react-navigation/native": "^7.3.11",
    "@react-navigation/native-stack": "^7.18.3",
    "lucide-react-native": "^1.25.0",
    "react": "19.2.3",
    "react-native": "0.86.0",
    "react-native-blob-util": "^0.24.10",
    "react-native-keychain": "11.0.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-share": "^12.3.1",
    "react-native-svg": "^15.15.5",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.1.0",
    "@react-native-community/cli-platform-android": "20.1.0",
    "@react-native-community/cli-platform-ios": "20.1.0",
    "@react-native/babel-preset": "0.86.0",
    "@react-native/eslint-config": "0.86.0",
    "@react-native/jest-preset": "^0.86.0",
    "@react-native/metro-config": "0.86.0",
    "@react-native/typescript-config": "0.86.0",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
